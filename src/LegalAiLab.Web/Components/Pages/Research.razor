@page "/research"
@inject ResearchWorkflow Workflow
@inject SessionStore Sessions
<PageTitle>Research</PageTitle>
<p class="notice">@ProductBoundary.Notice</p>
<form method="get">
    <label>Question <input name="question" value="@Question" size="80" /></label>
    <button type="submit">Run workflow</button>
</form>
@if (_state?.Report is { } report)
{
    <p>Session @_id · stage @_state.Stage</p>
    <h2>Findings</h2>
    @foreach (var finding in report.Findings) { <p>@finding</p> }
    <h2>Evidence</h2>
    @foreach (var passage in report.Evidence)
    {
        <article class="passage"><strong>@passage.Citation</strong> @passage.Text</article>
    }
    <h2>Limitations</h2>
    @foreach (var item in report.Limitations) { <p>@item</p> }
    <p><a href="@($"/history?session={_id}")">Open saved session</a></p>
}
@code {
    [SupplyParameterFromQuery(Name = "question")] public string? Question { get; set; }
    private ResearchState? _state;
    private string? _id;
    protected override async Task OnParametersSetAsync()
    {
        if (string.IsNullOrWhiteSpace(Question)) return;
        _state = await Workflow.RunAsync(Question);
        _id = Guid.NewGuid().ToString("n");
        await Sessions.SaveAsync(_id, _state);
    }
}
